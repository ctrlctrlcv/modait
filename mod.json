{
  "geode": "v5.11.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "olk.olkfpc",
  "name": "OlkFPC",
  "version": "1.0.0",
  "developer": "Olk",
  "description": "Frame Perfect Counter con analizador de macros (.cml, .ttr3, .gdr, .gdr2, .json), reproducción y renderizado.",
  "repository": "https://github.com/olkomos/modait",
  "settings": {
    "counter-title": { "type": "title", "name": "Counter" },
    "rows-mode": {
      "name": "Rows in the Top Corner",
      "type": "string",
      "default": "Normal",
      "one-of": ["Short", "Normal", "Personalize"]
    },
    "rows-custom": { "name": "Personalized Rows", "type": "string", "default": "13-15,9-12,7-8,5-6,4,3,2,1" },
    "copy-counts": { "name": "Copy Counts", "type": "bool", "default": true },
    "count-straight-fly": { "name": "Count Straight Fly", "type": "bool", "default": true },
    "count-wave-spam": { "name": "Count Wave Spam", "type": "bool", "default": true },

    "circles-title": { "type": "title", "name": "Circles" },
    "circle-size": { "name": "Circle Size (%)", "type": "float", "default": 100.0, "min": 20.0, "max": 300.0, "control": { "slider": true } },
    "number-size": { "name": "Number Size (%)", "type": "float", "default": 100.0, "min": 20.0, "max": 300.0, "control": { "slider": true } },
    "ms-under-number": { "name": "Milliseconds Under Number", "type": "bool", "default": true },
    "number-beside-ring": { "name": "Number Beside Ring", "type": "bool", "default": false },

    "sound-title": { "type": "title", "name": "Sounds" },
    "vary-pitch": { "name": "Vary Pitch", "type": "bool", "default": true },
    "sound-timing": {
      "name": "Sound Timing",
      "type": "string",
      "default": "On Click",
      "one-of": ["On Click", "Before Click", "After Click", "Perfect Frame"]
    },

    "scan-title": { "type": "title", "name": "Scan" },
    "scan-distance": {
      "name": "Frames Each Side",
      "type": "string",
      "default": "Auto",
      "one-of": ["Auto", "5", "10", "15", "20", "25", "30", "50"]
    },
    "scan-from": { "name": "From (%)", "type": "float", "default": 0.0, "min": 0.0, "max": 100.0, "control": { "slider": true } },
    "scan-to": { "name": "To (%)", "type": "float", "default": 100.0, "min": 0.0, "max": 100.0, "control": { "slider": true } },
    "scan-speed": {
      "name": "Scan Speed",
      "type": "string",
      "default": "FAST",
      "one-of": ["FULL", "FAST", "FASTEST"]
    },
    "local-check": { "name": "Local Check", "type": "bool", "default": true },

    "recording-title": { "type": "title", "name": "Recording" },
    "recording-speed": { "name": "Recording Speed (%)", "type": "float", "default": 100.0, "min": 20.0, "max": 500.0, "control": { "slider": true } },
    "playback-speed": { "name": "Playback Speed (%)", "type": "float", "default": 100.0, "min": 20.0, "max": 500.0, "control": { "slider": true } },
    "click-during-playback": { "name": "Click During Playback", "type": "bool", "default": false },

    "tools-title": { "type": "title", "name": "Tools" },
    "show-hitboxes": { "name": "Hitboxes", "type": "bool", "default": false },
    "hitboxes-on-death": { "name": "Hitboxes on Death", "type": "bool", "default": false },
    "hitbox-trail": { "name": "Hitbox Trail", "type": "bool", "default": false },
    "show-trajectory": { "name": "Trajectory", "type": "bool", "default": false },
    "frame-stepper": { "name": "Frame Stepper", "type": "bool", "default": false },
    "input-display": { "name": "Input Display", "type": "bool", "default": false },
    "render-preset": {
      "name": "Render Preset",
      "type": "string",
      "default": "1080p60",
      "one-of": ["720p30", "720p60", "1080p30", "1080p60", "1440p60", "4K30", "4K60", "Custom"]
    },

    "fps-title": { "type": "title", "name": "FPS" },
    "macro-fps": { "name": "Macro FPS", "type": "int", "default": 240, "min": 1, "max": 30000, "control": { "slider": true, "input": true } },
    "scan-fps": { "name": "Scan FPS", "type": "int", "default": 240, "min": 1, "max": 30000, "control": { "slider": true, "input": true } }
  }
}
